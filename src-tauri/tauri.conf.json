{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AndroidCreateLinuxGUITool",
  "version": "0.1.0",
  "identifier": "com.xlzhen.androidcreatelinuxguitool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Android Linux 桌面一键安装",
        "width": 1200,
        "height": 860,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/*.sh"]
  }
}
